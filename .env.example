# Copy to .env and fill in. .env is gitignored.

# TideCloak master admin (the "vendor root" account). Choose a strong value.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Tide licence: a real email you control, and `yes` only once YOU have read and
# agreed to Tide's Terms & Conditions at https://tide.org/legal
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

TIDECLOAK_URL=http://localhost:8080
REALM_NAME=camera-vault
CLIENT_NAME=camera-vault-client
CLIENT_APP_URL=http://localhost:5173

# Create CamCo's separate staff realm (camco-staff) at server start. Needs a Tide licence
# that allows another realm. Without it, /staff signs in with the demo realm's camco-support.
PROVISION_STAFF_REALM=
